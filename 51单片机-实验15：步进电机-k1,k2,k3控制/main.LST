 135          /*******************************************************************************
 136          * 函数名       : key_scan
 137          * 函数功能     : 按键扫描
 138          *******************************************************************************/
 139          void key_scan()
 140          {
 141   1          /*==================== K1：改变方向 ====================*/
 142   1      
 143   1          if(K1 == 0)
 144   1          {
 145   2              delay(1000);
 146   2      
 147   2              if(K1 == 0)
 148   2              {
 149   3                  direction = !direction;
 150   3      
 151   3                  while(K1 == 0);
 152   3              }
 153   2          }
 154   1      
 155   1      
 156   1          /*==================== K2：加速 ====================*/
 157   1      
 158   1          if(K2 == 0)
 159   1          {
 160   2              delay(1000);
 161   2      
 162   2              if(K2 == 0)
 163   2              {
 164   3                  /*
 165   3                   * SPEED越小，电机越快
 166   3                   *
 167   3                   * 所以K2按下后减小SPEED
 168   3                   */
 169   3                  if(SPEED >= 80)
 170   3                  {
 171   4                      SPEED = SPEED - 30;
 172   4                  }
 173   3      
 174   3                  while(K2 == 0);
 175   3              }
 176   2          }
 177   1      
 178   1      
 179   1          /*==================== K3：减速 ====================*/
C51 COMPILER V9.01   MAIN                                                                  09/05/2026 23:39:03 PAGE 4   

 180   1      
 181   1          if(K3 == 0)
 182   1          {
 183   2              delay(1000);
 184   2      
 185   2              if(K3 == 0)
 186   2              {
 187   3                  /*
 188   3                   * SPEED越大，电机越慢
 189   3                   *
 190   3                   * 所以K3按下后增加SPEED
 191   3                   */
 192   3                  if(SPEED <= 470)
 193   3                  {
 194   4                      SPEED = SPEED + 30;
 195   4                  }
 196   3      
 197   3                  while(K3 == 0);
 198   3              }
 199   2          }
 200   1      }
